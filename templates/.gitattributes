# Normalise all text files to LF, in the repository and in the working tree.
# The project standard is LF (.editorconfig `end_of_line = lf`, and csharpier
# writes LF). Without this, a Windows checkout with core.autocrlf=true converts
# files to CRLF, which then disagrees with csharpier/.editorconfig and produces
# phantom whitespace-only diffs. `eol=lf` pins the working tree to LF regardless
# of the local autocrlf setting.
* text=auto eol=lf

# Binary assets — never normalise or diff as text.
*.png binary
*.ico binary

